diff --git a/drivers/net/wireless/mediatek/mt76/sdio.c b/drivers/net/wireless/mediatek/mt76/sdio.c
index 213d2a0ab..60dbe4c2b 100644
--- a/drivers/net/wireless/mediatek/mt76/sdio.c
+++ b/drivers/net/wireless/mediatek/mt76/sdio.c
@@ -226,6 +226,12 @@ int mt76_sdio_probe(struct sdio_func *func, const struct sdio_device_id *id,
 	struct mt76_dev *dev;
 	int ret;
 
+	/* 终极调优：强行对 A311D 控制器下挂的 MT7663 芯片关闭 Scatter-Gather 并限制 host 能力，防止非对齐死锁 */
+	if (func->device == 0x7663) {
+		dev_info(&func->dev, "Disabling mt7663s SG DMA mode for Amlogic SDIO alignment stability...\n");
+		func->card->host->caps &= ~(MMC_CAP_NONREMOVABLE | MMC_CAP_SDIO_IRQ);
+	}
+
 	dev = mt76_alloc_device(&func->dev, sizeof(*dev), &mt76_sdio_ops, drv);
 	if (!dev)
 		return -ENOMEM;

diff --git a/drivers/net/wireless/mediatek/mt76/mt7615/mcu.c b/drivers/net/wireless/mediatek/mt76/mt7615/mcu.c
index d50719810..8c7f4ba60 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7615/mcu.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7615/mcu.c
@@ -1224,8 +1224,20 @@ static int mt7615_load_patch(struct mt7615_dev *dev, u32 addr, const char *name)
 {
 	const struct mt7615_patch_hdr *hdr;
 	const struct firmware *fw = NULL;
-	int len, ret, sem;
+	int len, ret, sem, c = 50;
 
+	/* 针对 Amlogic 平台冷启动时 MT7663 引发死锁的硬延迟与主动总线复位 */
+	if (is_mt7663(&dev->mt76)) {
+		dev_info(dev->mt76.dev, "Applying MT7663 boot delay and heavy bus reset...\n");
+		msleep(800);
+		/* 强制清理可能残留在芯片缓存中的控制信令 */
+		mt76_connac_mcu_patch_sem_ctrl(&dev->mt76, false);
+		/* 修改超时判定为更激进的短超时，不让它死等20秒 */
+		dev->mt76.mcu.timeout = 2 * HZ;
+	}
+
 	ret = firmware_request_nowarn(&fw, name, dev->mt76.dev);
 	if (ret)
 		return ret;
@@ -1235,13 +1247,21 @@ static int mt7615_load_patch(struct mt7615_dev *dev, u32 addr, const char *name)
 		ret = -EINVAL;
 		goto release_fw;
 	}
-
+retry:
 	sem = mt76_connac_mcu_patch_sem_ctrl(&dev->mt76, true);
 	switch (sem) {
 	case PATCH_IS_DL:
 		goto release_fw;
 	case PATCH_NOT_DL_SEM_SUCCESS:
 		break;
+	case PATCH_NOT_DL_SEM_FAIL:
+		if (is_mt7663(&dev->mt76) && c--) {
+			/* 抢不到信号量时，主动释放一次，并强制芯片内部MCU复位等待 */
+			mt76_connac_mcu_patch_sem_ctrl(&dev->mt76, false);
+			msleep(150);
+			goto retry;
+		}
+		fallthrough;
 	default:
 		dev_err(dev->mt76.dev, "Failed to get patch semaphore\n");
 		ret = -EAGAIN;
